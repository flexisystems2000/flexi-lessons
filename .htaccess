# Enable URL rewriting
RewriteEngine On

# Set the default homepage
DirectoryIndex index.php

# Redirect requests for existing .php pages to clean URLs
# Only redirect GET and HEAD requests
RewriteCond %{THE_REQUEST} \s/+(.+?)\.php(?:[\s?]) [NC]
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteRule ^ %1 [R=301,L,NE]

# Internally serve .php files when clean URLs are requested
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+?)/?$ $1.php [L]

# Prevent access to sensitive configuration files
<FilesMatch "^(?:\.env|composer\.(?:json|lock)|package(?:-lock)?\.json)$">
    Require all denied
</FilesMatch>

# Disable directory listing
Options -Indexes
