DirectoryIndex index.php index.html

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # ============================================================
    # HOMEPAGE
    # ============================================================
    RewriteRule ^$ index.php [END]

    # ============================================================
    # FLEXI LESSONS CLEAN URLS
    # Keep the browser on the clean URL.
    # Internally load the corresponding PHP file.
    # ============================================================

    RewriteRule ^register/?$ page2.php [END,NC]
    RewriteRule ^instructions/?$ page3.php [END,NC]
    RewriteRule ^access/?$ page4.php [END,NC]
    RewriteRule ^dashboard/?$ student-dashboard.php [END,NC]
    RewriteRule ^renewal/?$ renewal.php [END,NC]
    RewriteRule ^renewals/?$ renewal-receipt.php [END,NC]
    RewriteRule ^profile/?$ profile.php [END,NC]
    RewriteRule ^login/?$ login.php [END,NC]

    # ============================================================
    # EXISTING FILES AND DIRECTORIES
    # Allow PHP files, CSS, JavaScript, images and other real files
    # to be served normally.
    # ============================================================

    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [END]

    # ============================================================
    # OTHER EXTENSIONLESS PHP PAGES
    # Rewrite only when the corresponding PHP file exists.
    # Example: /some-page -> some-page.php
    # ============================================================

    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.+?)/?$ $1.php [END,NC]

</IfModule>

# ============================================================
# PROTECT HIDDEN FILES
# ============================================================

<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# ============================================================
# PROTECT CONFIGURATION AND DEPENDENCY FILES
# ============================================================

<FilesMatch "^(Dockerfile|composer\.(json|lock)|package(-lock)?\.json)$">
    Require all denied
</FilesMatch>
